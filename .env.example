# Supabase — tableau de bord : Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Serveur uniquement : contourne RLS, ne doit JAMAIS atteindre le navigateur.
# Clé « secret » (sb_secret_...) dans Settings > API Keys.
SUPABASE_SERVICE_ROLE_KEY=

# Protège la route de cron contre les appels externes.
# Générer avec : node -e "console.log(crypto.randomUUID())"
CRON_SECRET=
